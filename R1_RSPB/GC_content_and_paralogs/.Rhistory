############# Gene rank plot #################
getwd()
setwd("~/BUDDHA/upload-GITHUB_Thylacine_Genome-wide_GENELOSS/R1_RSPB/GC_content_and_paralogs")
library(ggplot2)
library(dplyr)
data <- read.table("./TOGA_info.nonempty.Tasmanian_devil_paralogue_mart_export.tsv", header = T, sep = "\t")
data<-na.omit(data)
df<- data[,c(1,4,6,10,15,16,17,19)]
head(df)
df_unique <- df[!duplicated(df), ]
head(df_unique)
##############
gene_gc_ranked <- df_unique %>%
select(Gene_stable_ID, gene_gc = Gene_._GC_content) %>%
distinct() %>%
arrange(gene_gc) %>%
mutate(sim_rank = row_number())
length(unique(gene_gc_ranked$sim_rank))
# Step 2: Rank unique paralogue GC content
paralogue_gc_ranked <- df_unique %>%
select(Tasmanian_devil_paralogue_protein_or_transcript_ID, paralogue_gc = Gene_._GC_content) %>%
distinct() %>%
arrange(paralogue_gc) %>%
mutate(map_rank = row_number())
length(unique(df_unique$Tasmanian_devil_paralogue_protein_or_transcript_ID))
df_plot <- df_unique %>%
left_join(gene_gc_ranked, by = "Gene_stable_ID") %>%
left_join(paralogue_gc_ranked, by = "Tasmanian_devil_paralogue_protein_or_transcript_ID")
View(df_plot)
df_plot <- df_plot %>%
mutate(identity_bin_raw = cut(
Paralogue_.id._target_Tasmanian_devil_gene_identical_to_query_gene,
breaks = c(0, 25, 50, 75, 100),
labels = c("0–25%", "25–50%", "50–75%", "75–100%"),
right = FALSE
))
bin_counts <- df_plot %>%
count(identity_bin_raw, name = "bin_size") %>%
mutate(identity_bin_labeled = paste0(identity_bin_raw, " (n=", bin_size, ")"))
# Join back to original data
df_plot <- df_plot %>%
left_join(bin_counts, by = c("identity_bin_raw")) %>%
mutate(identity_bin = fct_relevel(identity_bin_labeled, unique(identity_bin_labeled)))
length(unique(df_plot$map_rank))
View(df_plot)
ggplot(df_plot, aes(x = sim_rank, y = map_rank)) +
geom_point(aes(
color = TOGA_status,
size = identity_bin
), alpha = 0.3) +
scale_color_manual(values = c("skyblue", "blue", "green", "purple", "orange", "pink", "yellow")) +  # Manual color scale
labs(
x = "Gene stable ID (rank by GC content)",
y = "Tasmanian devil paralogue transcript ID (rank by GC content)",
color = "TOGA status",
size = "% Identity (Target Tasmanian devil gene vs Query)"
) +
theme_bw()
